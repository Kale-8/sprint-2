          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"document\": \"DOC-{{$timestamp}}\",\n  \"email\": \"client+{{$timestamp}}@example.com\",\n  \"phone\": \"3000000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created or OK', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "var data = pm.response.json(); if (data && data.id) { pm.collectionVariables.set('clientId', data.id); }"
                ]
              }
            }
          ]
        },
        { "name": "Get All Clients", "request": { "method": "GET", "url": "{{baseUrl}}/clients" } },
        { "name": "Get Client by Id", "request": { "method": "GET", "url": "{{baseUrl}}/clients/{{clientId}}" } },
        {
          "name": "Update Client (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/clients/{{clientId}}",
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"3111111111\"\n}" }
          }
        },
        { "name": "Delete Client", "request": { "method": "DELETE", "url": "{{baseUrl}}/clients/{{clientId}}" } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client\": { \"id\": \"{{clientId}}\" },\n  \"user\": { \"id\": \"{{userId}}\" },\n  \"paymentMethod\": \"CASH\",\n  \"status\": \"PENDING\",\n  \"total\": 199.98,\n  \"orderItems\": [\n    { \"product\": { \"id\": \"{{productId}}\" }, \"quantity\": 2, \"price\": 99.99, \"subtotal\": 199.98 }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created or OK', function () { pm.expect(pm.response.code).to.be.oneOf([200,201]); });",
                  "var data = pm.response.json(); if (data && data.id) { pm.collectionVariables.set('orderId', data.id); }"
                ]
              }
            }
          ]
        },
        { "name": "Get All Orders", "request": { "method": "GET", "url": "{{baseUrl}}/orders" } },
        { "name": "Get Order by Id", "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" } },
        {
          "name": "Update Order (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": "{{baseUrl}}/orders/{{orderId}}",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PAID\"\n}" }
          }
        },
        { "name": "Delete Order", "request": { "method": "DELETE", "url": "{{baseUrl}}/orders/{{orderId}}" } }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ]
}
